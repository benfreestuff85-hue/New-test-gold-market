# Set in Render Environment. This file is NOT loaded automatically.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Private chat: leave blank. Group: owner's personal numeric Telegram user ID.
TELEGRAM_USER_ID=
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY=
KALSHI_USE_DEMO=false
ENABLE_LIVE_ORDERS=false
GOLD_MAX_AGE_SECONDS=60
DASHBOARD_TOKEN=
TERMINAL_OUTPUT=true
PORT=10000
# Model/logging (all optional; defaults shown)
GOLD_VOL_MULT=1.1
GOLD_VOL_FLOOR=0.0001
# 1-sigma proxy-vs-Pyth-index error in USD. Guess until /calibration shows the real basis.
GOLD_BASIS_USD=0.75
MOMENTUM_ALERTS=false
# SQLite path. Render disks are ephemeral unless you attach a persistent disk; download /api/log before redeploys.
FORECAST_DB=forecast_log.db
