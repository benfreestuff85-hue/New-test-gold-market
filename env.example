# Set through Render Environment; this example is NOT loaded automatically.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# For private chat, owner user ID defaults to TELEGRAM_CHAT_ID.
# For a group chat, set TELEGRAM_USER_ID to the owner's personal numeric Telegram ID.
TELEGRAM_USER_ID=
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY=
KALSHI_USE_DEMO=false
ENABLE_LIVE_ORDERS=false
GOLD_MAX_AGE_SECONDS=60
DASHBOARD_TOKEN=
TERMINAL_OUTPUT=true
PORT=10000
